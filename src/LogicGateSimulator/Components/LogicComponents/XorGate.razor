@inherits LogicGateBaseComponent
@using LogicGatesGameLogic.Enums

<svg stroke="currentColor" viewBox="0 0 64 64" width="64" height="64" style="@(GetCssStyleAttribute())">
    @if (InputASignalMode is SignalModes.Normal)
    {
        <line x1="0" y1="24" x2="14" y2="24" stroke-width="2" />
    }
    else
    {
        <line x1="0" y1="24" x2="6" y2="24" stroke-width="2" />
        <circle r="4" cx="10" cy="24" stroke-width="2" />
    }

    @if (InputBSignalMode is SignalModes.Normal)
    {
        <line x1="0" y1="40" x2="14" y2="40" stroke-width="2" />
    }
    else
    {
        <line x1="0" y1="40" x2="6" y2="40" stroke-width="2" />
        <circle r="4" cx="10" cy="40" stroke-width="2" />
    }

    @if (OutputSignalMode is SignalModes.Normal)
    {
        <line x1="49" y1="32" x2="64" y2="32" stroke-width="2" />
    }
    else
    {
        <line x1="58" y1="32" x2="64" y2="32" stroke-width="2" />
        <circle r="4" cx="54" cy="32" stroke-width="2" />
    }

    <path d="M 12 16 A 40 40 0 0 1 12 48" fill="none" stroke-width="2" />
    <path d="M 18 16 A 48 48 0 0 1 49 32 A 48 48 0 0 1 18 48 A 40 40 0 0 0 18 16 Z" fill="none" stroke-width="2" />
</svg>
